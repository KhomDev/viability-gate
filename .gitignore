# .gitignore for viability-gate.
#
# This repository ships RULES, not data. The entries below exist to keep the
# user's own data out of the tree: the ledger you transcribe for a program, the
# scope file list, the known-issues corpus and your submission history are all
# yours, and none of them belongs in a public repository.

# --- your own target data (never commit) ------------------------------------
my-ledger*.yaml
my-ledger*.yml
my-known-issues*.yaml
my-known-issues*.yml
my-scope*.txt
.vg-history.yaml
.vg-history.yml
*.PRIVATE.yaml
*.PRIVATE.yml

# --- private redaction inputs (never commit) --------------------------------
# These are generated by tooling that lives outside this repository, and they
# are the only files that would contain real protocol names.
redaction-blocklist*.yaml
redaction-blocklist*.yml
protocol-map*.yaml
protocol-map*.yml
/source/
/private/
*.private.json

# --- secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# --- build / tooling --------------------------------------------------------
target/
dist/
build/
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
*.egg-info/

# --- scratch directories used by the maintenance scripts --------------------
.baseline/
.regen/
repro/

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
